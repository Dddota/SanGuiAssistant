  },
  "sinan_village_confirm_fallback": {
    "recognition": "DirectHit",
    "action": "Click",
    "target": [640, 500],
    "post_delay": 1000,
    "next": ["sinan_dismiss_reward"]
  },
  "sinan_check_available": {
    "recognition": "TemplateMatch",
