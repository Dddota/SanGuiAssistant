{
  "sinan_start": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": ["sinan_open_panel"],
    "pre_delay": 500
  },
  "sinan_open_panel": {
    "recognition": "TemplateMatch",
    "template": "sinan_tab_btn.png",
    "threshold": 0.7,
    "focus": true,
    "action": "Click",
    "post_delay": 2000,
    "next": ["sinan_panel_ready"],
    "on_error": ["sinan_open_retry"],
    "timeout": 5000,
    "times_limit": ["sinan_open_count", 3]
  },
  "sinan_open_retry": {
    "recognition": "DirectHit",
    "action": "Click",
    "target": [100, 600],
    "post_delay": 1000,
    "next": ["sinan_open_panel"]
  },
  "sinan_panel_ready": {
    "recognition": "TemplateMatch",
    "template": "sinan_first_item.png",
    "threshold": 0.7,
    "focus": true,
    "action": "DoNothing",
    "next": ["sinan_use_first"],
    "on_error": ["sinan_panel_check_available"],
    "timeout": 3000
  },
  "sinan_panel_check_available": {
    "recognition": "TemplateMatch",
    "template": "sinan_unavailable_percent.png",
    "threshold": 0.7,
    "focus": true,
    "action": "DoNothing",
    "next": ["sinan_finished"],
    "on_error": ["sinan_panel_wait"],
    "timeout": 3000
  },
  "sinan_panel_wait": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "pre_delay": 1500,
